# ── Site ────────────────────────────────────────────────────────────────
# "preview" (default): drafts shown with labels, noindex.
# "production": approved content only; build fails if launch blockers remain.
NEXT_PUBLIC_SITE_MODE=preview
# Final canonical origin, no trailing slash. Domain not chosen yet.
NEXT_PUBLIC_SITE_URL=

# ── Contact form delivery (server-only) ─────────────────────────────────
# "test"   = log inquiries to the server console (preview mode only; UI says it was not sent)
# "resend" = send through Resend (requires the three values below)
CONTACT_DELIVERY=test
RESEND_API_KEY=
# Inbox supplied by Marc/Austin. Do not assume the Institute's general address.
CONTACT_TO_EMAIL=
# Verified sender on the Resend account, e.g. "Marc Rodriguez Site <inquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=

# ── Optional: outbound business-link attribution ────────────────────────
NEXT_PUBLIC_UTM_SOURCE=
NEXT_PUBLIC_UTM_MEDIUM=referral
NEXT_PUBLIC_UTM_CAMPAIGN=marc-personal-site
